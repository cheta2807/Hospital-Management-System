# Copy to `.env` for Docker Compose:   cp .env.example .env
# Every value has a safe local default in docker-compose.yml, so .env is optional locally.

# ---------- MySQL ----------
MYSQL_DATABASE=hms_db
MYSQL_USER=hms_user
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---------- Django API ----------
# Use a long random value (32+ chars):  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=false
# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Needed for the Django admin over HTTPS in production (your API's own URL)
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata
# Creates demo users (admin, dr.sharma, reception, patient1) on startup. Turn OFF for real data.
SEED_DEMO=true
# Shared secret between Django and the Node service
INTERNAL_API_KEY=change-me-internal-key

# For a hosted database, set ONE connection string instead of the DB_* values:
# DATABASE_URL=mysql://user:password@host:3306/dbname
# If the provider requires TLS: DB_SSL=true   (or DB_SSL_CA=/path/to/ca.pem)

# ---------- Node notification service ----------
HOSPITAL_NAME=City Care Hospital
# Optional SMTP for reminder emails. Without it, emails are only printed to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@hospital.local

# ---------- React frontend (baked in at build time) ----------
VITE_API_URL=http://localhost:8000/api
VITE_NOTIFY_URL=http://localhost:5000/api
VITE_SHOW_DEMO=true
